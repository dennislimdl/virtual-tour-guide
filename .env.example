# Required for the map itself: a Google Maps JavaScript API key from
# Google Cloud Console (Maps JavaScript API enabled on the project).
# NOTE: unlike GEMINI_API_KEY below, this key runs in the browser — it is
# not a secret. Restrict it in Cloud Console (HTTP referrers = your domain,
# API restrictions = Maps JavaScript API) rather than trying to hide it.
# Must be prefixed VITE_ so Vite exposes it to client code, and must be set
# at BUILD time (not just runtime) since Vite inlines it into the bundle.
VITE_GOOGLE_MAPS_API_KEY=

# Required for the AI voice guide (narration + conversation) served by /api/guide.
# Get a free key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model used by the AI guide (defaults to gemini-3.6-flash).
# Use "gemini-flash-lite-latest" for a higher free-tier daily request quota.
# GEMINI_MODEL=gemini-3.6-flash
